{
  "_version": "1.59.0",
  "sap.app": {
    "id": "j62.asset.ui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/J62AssetService/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ushell": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "j62.asset.ui.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "AssetMasterList",
          "target": "AssetMasterList"
        },
        {
          "pattern": "AssetMaster({key}):?query:",
          "name": "AssetMasterObjectPage",
          "target": "AssetMasterObjectPage"
        },
        {
          "pattern": "PurchaseRequisition:?query:",
          "name": "PurchaseRequisitionList",
          "target": "PurchaseRequisitionList"
        },
        {
          "pattern": "PurchaseRequisition({key}):?query:",
          "name": "PurchaseRequisitionObjectPage",
          "target": "PurchaseRequisitionObjectPage"
        },
        {
          "pattern": "PurchaseOrder:?query:",
          "name": "PurchaseOrderList",
          "target": "PurchaseOrderList"
        },
        {
          "pattern": "PurchaseOrder({key}):?query:",
          "name": "PurchaseOrderObjectPage",
          "target": "PurchaseOrderObjectPage"
        },
        {
          "pattern": "GoodsReceipt:?query:",
          "name": "GoodsReceiptList",
          "target": "GoodsReceiptList"
        },
        {
          "pattern": "GoodsReceipt({key}):?query:",
          "name": "GoodsReceiptObjectPage",
          "target": "GoodsReceiptObjectPage"
        },
        {
          "pattern": "Invoice:?query:",
          "name": "InvoiceList",
          "target": "InvoiceList"
        },
        {
          "pattern": "Invoice({key}):?query:",
          "name": "InvoiceObjectPage",
          "target": "InvoiceObjectPage"
        }
      ],
      "targets": {
        "AssetMasterList": {
          "type": "Component",
          "id": "AssetMasterList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/AssetMaster",
              "variantManagement": "Page",
              "navigation": {
                "AssetMaster": {
                  "detail": {
                    "route": "AssetMasterObjectPage"
                  }
                }
              },
              "initialLoad": "Enabled",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "creationMode": {
                      "name": "NewPage"
                    }
                  }
                }
              }
            }
          }
        },
        "AssetMasterObjectPage": {
          "type": "Component",
          "id": "AssetMasterObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/AssetMaster"
            }
          }
        },
        "PurchaseRequisitionList": {
          "type": "Component",
          "id": "PurchaseRequisitionList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/PurchaseRequisition",
              "variantManagement": "Page",
              "navigation": {
                "PurchaseRequisition": {
                  "detail": {
                    "route": "PurchaseRequisitionObjectPage"
                  }
                }
              },
              "initialLoad": "Enabled",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "creationMode": {
                      "name": "NewPage"
                    }
                  }
                }
              }
            }
          }
        },
        "PurchaseRequisitionObjectPage": {
          "type": "Component",
          "id": "PurchaseRequisitionObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/PurchaseRequisition"
            }
          }
        },
        "PurchaseOrderList": {
          "type": "Component",
          "id": "PurchaseOrderList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/PurchaseOrder",
              "variantManagement": "Page",
              "navigation": {
                "PurchaseOrder": {
                  "detail": {
                    "route": "PurchaseOrderObjectPage"
                  }
                }
              },
              "initialLoad": "Enabled",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "creationMode": {
                      "name": "NewPage"
                    }
                  }
                }
              }
            }
          }
        },
        "PurchaseOrderObjectPage": {
          "type": "Component",
          "id": "PurchaseOrderObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/PurchaseOrder"
            }
          }
        },
        "GoodsReceiptList": {
          "type": "Component",
          "id": "GoodsReceiptList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/GoodsReceipt",
              "variantManagement": "Page",
              "navigation": {
                "GoodsReceipt": {
                  "detail": {
                    "route": "GoodsReceiptObjectPage"
                  }
                }
              },
              "initialLoad": "Enabled",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "creationMode": {
                      "name": "NewPage"
                    }
                  }
                }
              }
            }
          }
        },
        "GoodsReceiptObjectPage": {
          "type": "Component",
          "id": "GoodsReceiptObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/GoodsReceipt"
            }
          }
        },
        "InvoiceList": {
          "type": "Component",
          "id": "InvoiceList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Invoice",
              "variantManagement": "Page",
              "navigation": {
                "Invoice": {
                  "detail": {
                    "route": "InvoiceObjectPage"
                  }
                }
              },
              "initialLoad": "Enabled",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "creationMode": {
                      "name": "NewPage"
                    }
                  }
                }
              }
            }
          }
        },
        "InvoiceObjectPage": {
          "type": "Component",
          "id": "InvoiceObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Invoice"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
